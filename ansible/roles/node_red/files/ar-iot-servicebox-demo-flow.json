  {
    "id": "d5f1bd125d55a7d1",
    "type": "function",
    "z": "f0f8e0304e3a0a41",
    "name": "Normalize technical telemetry",
    "func": "const payload = msg.payload || {};\nconst fanSelected = payload.fan_select ? \"A\" : \"B\";\nconst fanReportedRpm = fanSelected === \"A\" ? Number(payload.fan_a_rpm || 0) : Number(payload.fan_b_rpm || 0);\nconst pwmPercent = Math.round((Number(payload.fan_pwm || 0) / 255) * 100);\n\nmsg.payload = {\n    device_id: String(payload.device_id || \"unknown-device\"),\n    timestamp_ms: Number(payload.timestamp_ms || 0),\n    system_state: String(payload.system_state || \"UNKNOWN\"),\n    temperature_env_c: Number(payload.temperature_env_c || 0),\n    humidity_pct: Number(payload.humidity_pct || 0),\n    fan_selected: fanSelected,\n    fan_reported_rpm: fanReportedRpm,\n    fan_pwm_percent: Number.isFinite(pwmPercent) ? pwmPercent : 0,\n    wifi_connected: Boolean(payload.wifi_connected),\n    mqtt_connected: Boolean(payload.mqtt_connected),\n    error_code: String(payload.error_code || \"\")\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 120,
    "wires": [
      [
        "6ee3578c0b2f0cb4"
      ]
    ]
  },
  {
    "id": "6ee3578c0b2f0cb4",
    "type": "ui-template",
    "z": "f0f8e0304e3a0a41",
    "group": "49bf27808712a70d",
    "page": "",
    "ui": "",
    "name": "Technical telemetry card",
    "order": 1,
    "width": "12",
    "height": "7",
    "head": "",
    "format": "<template>\n  <div class=\"telemetry-grid\">\n    <div class=\"metric\"><span class=\"label\">Device</span><span class=\"value\">{{ telemetry.device_id || 'n/a' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">State</span><span class=\"value\">{{ telemetry.system_state || 'UNKNOWN' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">Temp</span><span class=\"value\">{{ telemetry.temperature_env_c ?? 0 }} C</span></div>\n    <div class=\"metric\"><span class=\"label\">Humidity</span><span class=\"value\">{{ telemetry.humidity_pct ?? 0 }} %</span></div>\n    <div class=\"metric\"><span class=\"label\">Fan</span><span class=\"value\">{{ telemetry.fan_selected || '-' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">RPM</span><span class=\"value\">{{ telemetry.fan_reported_rpm ?? 0 }}</span></div>\n    <div class=\"metric\"><span class=\"label\">PWM</span><span class=\"value\">{{ telemetry.fan_pwm_percent ?? 0 }} %</span></div>\n    <div class=\"metric\"><span class=\"label\">Wi-Fi</span><span class=\"value\">{{ telemetry.wifi_connected ? 'OK' : 'DOWN' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">MQTT</span><span class=\"value\">{{ telemetry.mqtt_connected ? 'OK' : 'DOWN' }}</span></div>\n    <div class=\"metric metric-wide\"><span class=\"label\">Error</span><span class=\"value\">{{ telemetry.error_code || 'none' }}</span></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    telemetry () {\n      return this.msg?.payload || {}\n    }\n  }\n}\n</script>\n\n<style>\n.telemetry-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n.metric {\n  background: #f3f6f8;\n  border: 1px solid #d7e0e5;\n  border-radius: 10px;\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.metric-wide {\n  grid-column: 1 / -1;\n}\n.label {\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  color: #5b6975;\n}\n.value {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #10212b;\n}\n</style>",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 950,
    "y": 120,
    "wires": [
      []
    ]
  },
