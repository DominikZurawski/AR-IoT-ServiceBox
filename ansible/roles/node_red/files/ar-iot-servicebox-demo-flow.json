  {
    "id": "5bd01da0e36e5b3f",
    "type": "ui-template",
    "z": "f0f8e0304e3a0a41",
    "group": "68811dce99cbba67",
    "page": "",
    "ui": "",
    "name": "Command panel",
    "order": 1,
    "width": "12",
    "height": "10",
    "head": "",
    "format": "<template>\n  <div class=\"command-panel\">\n    <label>Device ID</label>\n    <input v-model=\"deviceId\" type=\"text\" />\n\n    <label>PWM: {{ pwm }}</label>\n    <input v-model=\"pwm\" type=\"range\" min=\"0\" max=\"100\" />\n\n    <label>Fault</label>\n    <select v-model=\"fault\">\n      <option value=\"fan_blocked\">fan_blocked</option>\n      <option value=\"overtemperature\">overtemperature</option>\n      <option value=\"clear\">clear</option>\n    </select>\n\n    <div class=\"actions\">\n      <button @click=\"sendPwm\">Send PWM</button>\n      <button @click=\"sendFault\">Simulate fault</button>\n      <button @click=\"sendResume\">Resume auto PWM</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () {\n    return {\n      deviceId: 'ARBOX-001',\n      pwm: 80,\n      fault: 'fan_blocked'\n    }\n  },\n  methods: {\n    sendPwm () {\n      this.send({\n        device_id: this.deviceId,\n        payload: {\n          command: 'set_fan_pwm',\n          fan: 'selected',\n          value: Number(this.pwm)\n        }\n      })\n    },\n    sendFault () {\n      this.send({\n        device_id: this.deviceId,\n        payload: {\n          command: 'simulate_fault',\n          fault: this.fault\n        }\n      })\n    },\n    sendResume () {\n      this.send({\n        device_id: this.deviceId,\n        payload: {\n          command: 'resume_auto_pwm'\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style>\n.command-panel {\n  display: grid;\n  gap: 10px;\n}\n.command-panel label {\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  color: #5b6975;\n}\n.command-panel input,\n.command-panel select,\n.command-panel button {\n  padding: 10px 12px;\n  border-radius: 8px;\n  border: 1px solid #c9d4dc;\n}\n.command-panel input[type='range'] {\n  padding: 0;\n}\n.actions {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 8px;\n}\n.command-panel button {\n  background: #0f7a5a;\n  color: #ffffff;\n  font-weight: 600;\n  cursor: pointer;\n}\n.command-panel button:nth-child(2) {\n  background: #b05b18;\n}\n.command-panel button:nth-child(3) {\n  background: #254f7a;\n}\n</style>",
    "storeOutMessages": true,
