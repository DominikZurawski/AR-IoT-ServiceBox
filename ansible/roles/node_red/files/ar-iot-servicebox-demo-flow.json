    "z": "f0f8e0304e3a0a41",
    "name": "Normalize quest telemetry",
    "func": "const payload = msg.payload || {};\nmsg.payload = {\n    device_id: String(payload.device_id || \"unknown-device\"),\n    timestamp: Number(payload.timestamp || 0),\n    fanReportedRPM: Number(payload.fanReportedRPM || 0),\n    fanReportedPWM: Number(payload.fanReportedPWM || 0),\n    fanSelected: String(payload.fanSelected || \"-\"),\n    sensorTemperature: Number(payload.sensorTemperature || 0),\n    sensorHumidity: Number(payload.sensorHumidity || 0),\n    systemState: String(payload.systemState || \"UNKNOWN\"),\n    errorCode: String(payload.errorCode || \"\")\n};\nreturn msg;",
