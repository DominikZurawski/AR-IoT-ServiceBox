  {
    "id": "4488a9e7ea2c52df",
    "type": "ui-template",
    "z": "f0f8e0304e3a0a41",
    "group": "f9be88b2a9eb5585",
    "page": "",
    "ui": "",
    "name": "Quest telemetry card",
    "order": 1,
    "width": "12",
    "height": "7",
    "head": "",
    "format": "<template>\n  <div class=\"telemetry-grid quest-grid\">\n    <div class=\"metric\"><span class=\"label\">AR Device</span><span class=\"value\">{{ telemetry.device_id || 'n/a' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">State</span><span class=\"value\">{{ telemetry.systemState || 'UNKNOWN' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">Temp</span><span class=\"value\">{{ telemetry.sensorTemperature ?? 0 }} C</span></div>\n    <div class=\"metric\"><span class=\"label\">Humidity</span><span class=\"value\">{{ telemetry.sensorHumidity ?? 0 }} %</span></div>\n    <div class=\"metric\"><span class=\"label\">Selected fan</span><span class=\"value\">{{ telemetry.fanSelected || '-' }}</span></div>\n    <div class=\"metric\"><span class=\"label\">RPM</span><span class=\"value\">{{ telemetry.fanReportedRPM ?? 0 }}</span></div>\n    <div class=\"metric\"><span class=\"label\">PWM</span><span class=\"value\">{{ telemetry.fanReportedPWM ?? 0 }} %</span></div>\n    <div class=\"metric metric-wide\"><span class=\"label\">Error</span><span class=\"value\">{{ telemetry.errorCode || 'none' }}</span></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    telemetry () {\n      return this.msg?.payload || {}\n    }\n  }\n}\n</script>\n\n<style>\n.quest-grid .metric {\n  background: #fff8ee;\n  border-color: #ecd4a2;\n}\n</style>",
